# Telegram Bot Token from @BotFather
BOT_TOKEN=your_bot_token_here

# Web App URL (где будет размещено мини-приложение)
WEBAPP_URL=https://your-domain.com/webapp

# Прокси для YouTube (необязательно, если используете прокси)
# Формат: http://user:pass@host:port или socks5://host:port
PROXY_URL=

# Invidious instance (альтернатива прокси)
INVIDIOUS_INSTANCE=https://invidious.io

# Путь для сохранения скачанных видео
DOWNLOAD_PATH=./downloads

# Максимальный размер файла для скачивания (MB)
MAX_FILE_SIZE=50
